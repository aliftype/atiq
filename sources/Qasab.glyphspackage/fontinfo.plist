lookup rclt_teeth_3 {
	lookupflag IgnoreMarks;

	ignore
	sub [beh-ar.init.high beh-ar.medi.high]
		[beh-ar.init beh-ar.medi]'
		[ain-ar.medi ain-ar.fina
		 feh-ar.medi feh-ar.medi.yeh feh-ar.fina
		 heh-ar.medi heh-ar.fina]
	;
	sub	[beh-ar.init beh-ar.medi]' lookup high_beh
		[ain-ar.medi ain-ar.fina
		 seen-ar.medi seen-ar.fina]
	;

	sub	[beh-ar.init beh-ar.medi]' lookup med_beh
		[feh-ar.medi feh-ar.medi.yeh feh-ar.fina
		 heh-ar.medi heh-ar.fina]
	;
} rclt_teeth_3;

lookup rclt_teeth_4 {
	lookupflag IgnoreMarks;
	sub	[beh-ar.init.high beh-ar.medi.high]
